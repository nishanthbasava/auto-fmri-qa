# Copy to .env (gitignored). Compose passes these to the api container.
JWT_SECRET=change-me-to-a-long-random-string      # signs login tokens; rotate to log everyone out
POSTGRES_PASSWORD=change-me                        # used by both db and api services
ANTHROPIC_API_KEY=sk-ant-...                       # only needed for agent figure review
# APP_PASSWORD=...   # optional: legacy shared password, accepted as the built-in admin "lab"
